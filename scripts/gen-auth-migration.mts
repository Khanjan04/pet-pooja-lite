// Prints the SQL Better Auth needs for our options. Run against an EMPTY database:
//   DATABASE_URL=postgres://.../empty npx tsx scripts/gen-auth-migration.mts > db/migrations/0001_auth.sql
import { Pool } from "pg";
import { getMigrations } from "better-auth/db/migration";
import { authSchemaOptions } from "../src/server/auth-options.ts";

const pool = new Pool({ connectionString: process.env.DATABASE_URL });
const { compileMigrations } = await getMigrations({ database: pool, ...authSchemaOptions() });
console.log("-- Better Auth tables (generated by scripts/gen-auth-migration.mts; do not edit by hand)\n");
console.log(await compileMigrations());
await pool.end();
