# Copy to .env.local and fill in. Never commit real values.

# Postgres 15+ (Supabase, Neon or your own). Use the pooled URL in production.
DATABASE_URL=
# Public URL of the app, e.g. https://pos.example.com (http://localhost:3000 in dev)
APP_URL=
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 24+ random characters; Vercel Cron sends it as "Authorization: Bearer ..."
CRON_SECRET=

# Email (Resend). Required in production. Without it, dev emails are logged and kept in the jobs table.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Restaurant POS <no-reply@pos.example.com>"
EMAIL_FROM=

# Optional: Google sign-in with your own OAuth client (redirect: $APP_URL/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay subscriptions. Use TEST mode keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay → Webhooks (URL: $APP_URL/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=
# Plan ids you create in Razorpay → Subscriptions → Plans (monthly, per outlet)
RAZORPAY_PLAN_CORE=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=
